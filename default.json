{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Update kadet-hub generators pinned as ghcr.io/kadet-hub/<name>:<version>@sha256:<digest> in Kapitan inventories, and the renovate-config commit that kubernetes-versions.json is fetched at",
  "customManagers": [
    {
      "customType": "regex",
      "description": "kadet-hub generators in kapitan.dependencies",
      "managerFilePatterns": [
        "**/inventory/**/*.yml",
        "**/inventory/**/*.yaml"
      ],
      "matchStrings": [
        "source:\\s*[\"']?(?<depName>ghcr\\.io/kadet-hub/[a-z][a-z0-9-]{1,38}):(?<currentValue>[A-Za-z0-9_][A-Za-z0-9._-]{0,127})@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "renovate-config commit and kubernetes-versions tag of kubernetes-versions.json URLs",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/",
        "/\\.sh$/"
      ],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/kadet-hub/renovate-config/(?<currentDigest>[0-9a-f]{40})/kubernetes-versions\\.json # (?<currentValue>kubernetes-versions-\\S+)"
      ],
      "depNameTemplate": "kadet-hub/renovate-config",
      "packageNameTemplate": "https://github.com/kadet-hub/renovate-config",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "regex:^kubernetes-versions-(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})(?:-(?<build>\\d+))?$"
    }
  ],
  "packageRules": [
    {
      "description": "One labelled pull request per generator update, never merged automatically and never held by a minimumReleaseAge: ghcr.io reports no release timestamps",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/kadet-hub/*"
      ],
      "addLabels": [
        "kadet-hub"
      ],
      "automerge": false,
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Moves kubernetes-versions.json to its newest kubernetes-versions tag; git tags report no release timestamps",
      "matchDatasources": [
        "git-tags"
      ],
      "matchPackageNames": [
        "https://github.com/kadet-hub/renovate-config"
      ],
      "addLabels": [
        "kadet-hub"
      ],
      "automerge": false,
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
